# ==============================================================================
# Kuku Promo Studio — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# AI Provider Configuration (Milestone 2)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for AI promo candidate discovery)
GEMINI_API_KEY=

# Configurable Gemini Model Identifier (Defaults to economical gemini-3.5-flash-lite)
# Recommended options:
# - gemini-3.5-flash-lite (Fast, cost-effective, high quota availability)
# - gemini-3.5-flash (Deeper reasoning for complex multi-character scenes)
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
# Neon Serverless PostgreSQL Configuration (Optional for preview/inspection)
# 1. APPLICATION POOLED CONNECTION (Used by FastAPI runtime)
DATABASE_URL=postgresql+psycopg://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. DIRECT MIGRATION CONNECTION (Used by Alembic for schema migrations)
DIRECT_URL=postgresql+psycopg://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins (Comma-separated for local dev & preview environments)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Parser & Ingestion Limits (Defaults shown)
MAX_ZIP_SIZE_BYTES=52428800           # 50 MB
MAX_MEMBER_COUNT=500                   # Up to 500 members per archive
MAX_UNCOMPRESSED_BYTES=52428800        # 50 MB max extracted bytes

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Base API URL. In local development with Vite dev server, empty string uses Vite's proxy.
VITE_API_URL=
